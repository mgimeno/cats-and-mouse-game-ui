{
  "name": "cats-and-mouse-game-ui",
  "sideEffects": [
    "src/polyfills.ts"
  ],
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production && npm run pre-brotli:dist",
    "generate:material-symbols-font": "tsx scripts/generate-material-symbols-font.ts",
    "pre-gzip:dist": "node scripts/pre-gzip-dist.mjs",
    "pre-brotli:dist": "node scripts/pre-brotli-dist.mjs",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.spec.json",
    "lint": "ng lint && npm run lint:styles && npm run format:check",
    "lint:ts": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:fix": "ng lint --fix && npm run lint:styles:fix && npm run format:write",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "validate": "npm run lint && npm run typecheck && npm run build",
    "check-all-updatable-dependencies": "npx npm-check-updates -u",
    "update-all-dependencies": "npx npm-check-updates -u && npm i -f"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions",
    "Firefox ESR"
  ],
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "~22.2.5",
    "@angular/compiler": "~22.2.5",
    "@angular/core": "~22.2.5",
    "@angular/forms": "~22.2.5",
    "@angular/localize": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "~22.2.5",
    "@angular/router": "~22.2.5",
    "@microsoft/signalr": "10.0.11",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "~22.2.5",
    "@angular/language-service": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
